{
  "name": "benchmark-styling",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:build:android:local": "eas build -p android --local --output ./builds/benchmark-styling.apk",
    "eas:build:ios:local": "eas build -p ios --local --output ./builds/benchmark-styling.ipa",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "~4.3.3",
    "uniwind": "~1.12.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@swmansion/argent": "^0.25.2",
    "@types/node": "^24",
    "@types/react": "~19.2.14",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.2.5"
}
